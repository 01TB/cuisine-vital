-- ===== REQUÊTES DE VÉRIFICATION =====

-- Vérification des commandes individuelles
SELECT 
    ci.numero_commande,
    CONCAT(c.prenom, ' ', c.nom) as client,
    ci.date_commande,
    ci.montant_total,
    sc.nom as statut,
    CONCAT(u.prenom, ' ', u.nom) as livreur,
    ci.adresse_livraison
FROM commandes_individuelles ci
JOIN clients c ON ci.client_id = c.id
LEFT JOIN statuts_commande sc ON ci.statut_id = sc.id
LEFT JOIN utilisateurs u ON ci.livreur_id = u.id
ORDER BY ci.created_at DESC;

-- Vérification des détails des commandes individuelles
SELECT 
    ci.numero_commande,
    m.nom as menu,
    a.nom as accompagnement,
    cid.quantite,
    cid.prix_unitaire,
    (cid.quantite * cid.prix_unitaire) as sous_total,
    cid.notes
FROM commandes_individuelles_details cid
JOIN commandes_individuelles ci ON cid.commande_id = ci.id
LEFT JOIN menus m ON cid.menu_id = m.id
LEFT JOIN accompagnements a ON cid.accompagnement_id = a.id
ORDER BY ci.numero_commande, cid.id;

-- Vérification des commandes entreprises
SELECT 
    ce.numero_commande,
    c.nom as entreprise,
    ce.date_commande,
    ce.montant_total,
    sc.nom as statut,
    CONCAT(u.prenom, ' ', u.nom) as livreur,
    ce.adresse_livraison
FROM commandes_entreprises ce
JOIN clients c ON ce.client_id = c.id
LEFT JOIN statuts_commande sc ON ce.statut_id = sc.id
LEFT JOIN utilisateurs u ON ce.livreur_id = u.id
ORDER BY ce.created_at DESC;

-- Vérification des détails des commandes entreprises
SELECT 
    ce.numero_commande,
    m.nom as menu,
    ced.quantite,
    ced.prix_unitaire,
    (ced.quantite * ced.prix_unitaire) as sous_total,
    ced.notes
FROM commandes_entreprises_details ced
JOIN commandes_entreprises ce ON ced.commande_id = ce.id
LEFT JOIN menus m ON ced.menu_id = m.id
ORDER BY ce.numero_commande, ced.id;



